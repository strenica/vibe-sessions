def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="vibe-sessions",
        description="Browse and resume every Mistral Vibe session, across all folders.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  vibe-sessions                 fuzzy picker, Enter resumes\n"
            "  vibe-sessions --list          plain table\n"
            "  vibe-sessions --folder        only this folder, like Vibe's own picker\n"
            "  vibe-sessions --json | jq     script it\n"
        ),
    )
    parser.add_argument("--version", action="version", version=f"vibe-sessions {__version__}")
    parser.add_argument("-l", "--list", action="store_true", help="print a table instead of opening the picker")
    parser.add_argument("-j", "--json", action="store_true", help="print JSON instead of opening the picker")
    parser.add_argument("-a", "--all", action="store_true", help="include archived sessions")
    parser.add_argument("-f", "--folder", dest="only_folder", action="store_true",
                        help="only sessions started in the current directory")
    parser.add_argument("-n", "--limit", type=int, default=0, help="show at most N sessions")
    parser.add_argument("--filter", metavar="QUERY",
                        help="non-interactive fuzzy match, prints the matching rows")
    parser.add_argument("--preview", metavar="ID", help="print the detail view for one session and exit")
    parser.add_argument("--delete", metavar="ID",
                        help="delete a session (asks first; refuses while it is running)")
    parser.add_argument("--force", action="store_true", help="skip the confirmation for --delete")
    parser.add_argument("--menu", metavar="ID",
                        help="open the action menu for one session (rename, tag, delete)")
    parser.add_argument("--rename", metavar="ID", help="rename a session")
    parser.add_argument("--title", metavar="TEXT", help="the new title for --rename")
    parser.add_argument("--tag", metavar="ID", help="set the tags for a session")
    parser.add_argument("--tags", metavar="LIST", help="comma separated tags for --tag")
    parser.add_argument("--prune-config", action="store_true",
                        help="remove config.toml allowlist entries for sessions that no longer exist")
    parser.add_argument("--dry-run", action="store_true", help="show what --prune-config would remove")
    parser.add_argument("--sort", metavar="MODE", choices=SORT_MODES,
                        help="sort order, remembered: " + ", ".join(SORT_MODES))
    parser.add_argument("--cycle-sort", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--raw", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--no-cd", action="store_true", help="resume without changing to the session's folder")
    parser.add_argument("--print", action="store_true", help="print the resume command instead of running it")
    parser.add_argument("--exec", action="store_true", help="replace this process with vibe instead of running it as a child")
    parser.add_argument("--no-color", action="store_true", help="disable colour in --list output")
    return parser


def find_session(identifier: str, deep: bool = False) -> dict | None:
    """Resolve a full id or an 8-character prefix, archived sessions included."""
    live = running_pids()
    for path in session_dirs():
        session = load_session(path, live, deep=deep)
        if session["id"] == identifier or session["short"] == identifier:
            return session
    return None


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    if args.preview:
        session = find_session(args.preview, deep=True)
        if session is None:
            print(f"vibe-sessions: no session {args.preview}", file=sys.stderr)
            return 1
        print_preview(session)
        return 0

    if args.delete:
        session = find_session(args.delete)
        if session is None:
            print(f"vibe-sessions: no session {args.delete}", file=sys.stderr)
            return 1
        return cmd_delete(session, force=args.force)

    if args.prune_config:
        return cmd_prune_config(dry_run=args.dry_run)

    if args.cycle_sort:
        print(cycle_sort())
        return 0

    if args.sort:
        set_sort(args.sort)

    for flag, handler in (
        (args.menu, cmd_menu),
        (args.rename, lambda s: cmd_rename(s, args.title)),
        (args.tag, lambda s: cmd_tag(s, args.tags)),
    ):
        if flag:
            session = find_session(flag)
            if session is None:
                print(f"vibe-sessions: no session {flag}", file=sys.stderr)
                return 1
            return handler(session)

    sessions = collect(
        include_archived=args.all,
        only_dir=os.getcwd() if args.only_folder else None,
    )
    if args.limit > 0:
        sessions = sessions[: args.limit]

    if args.raw:
        for session in sessions:
            print(f"{table_row(session, color=True)}\t{session['id']}")
        return 0

    if args.json:
        payload = []
        for session in sessions:
            item = dict(session)
            item["started"] = session["started"].isoformat() if session["started"] else None
            item["updated"] = session["updated"].isoformat() if session["updated"] else None
            payload.append(item)
        print(json.dumps(payload, indent=2))
        return 0

    if args.list:
        color = sys.stdout.isatty() and not args.no_color
        print_table(sessions, color=color)
        return 0

    return pick(sessions, args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
