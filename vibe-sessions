# actions
# --------------------------------------------------------------------------- #


def resume(session: dict, *, change_dir: bool, print_only: bool, exec_shell: bool) -> int:
    directory = session["directory"]
    command = ["vibe", "--resume", session["id"]]

    if print_only:
        prefix = f"cd {directory} && " if change_dir and directory else ""
        print(prefix + " ".join(command))
        return 0

    if change_dir and directory and os.path.isdir(directory):
        os.chdir(directory)
    elif change_dir and directory:
        print(f"vibe-sessions: {directory} no longer exists, staying in {os.getcwd()}", file=sys.stderr)

    try:
        if exec_shell:
            os.execvp(command[0], command)
        return subprocess.call(command)
    except FileNotFoundError:
        print(
            "vibe-sessions: `vibe` is not on PATH, so the session cannot be resumed",
            file=sys.stderr,
        )
        return 1


def clear_screen() -> None:
    """Blank the terminal before a nested fzf draws its window.

    A nested fzf renders in a window and leaves the rest of the screen alone,
    so without this the parent picker stays visible around and behind the
    menu, which reads as the menu being appended to the list rather than
    being its own thing.
    """
    if sys.stdout.isatty():
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()


def has_tty() -> bool:
    """True when there is a controlling terminal to draw a box on."""
    try:
        with open("/dev/tty"):
            return True
    except OSError:
        return False


def confirm(prompt: str, title: str = "vibe-sessions") -> bool:
    """Yes/no box, defaulting to No so a stray Enter never deletes anything.

    fzf is preferred over whiptail: this runs inside fzf's own `execute`, and
    whiptail does not understand modern key encodings such as CSI-u. It sees
    the ESC of a Ctrl+Backspace, quits, and the rest of the sequence leaks
    into the parent fzf as a search query.
    """
    if shutil.which("fzf"):
        try:
            clear_screen()
            result = subprocess.run(
                [
                    "fzf",
                    "--height=~20%",
                    "--layout=reverse",
                    "--no-info",
                    "--border=rounded",
                    f"--border-label= {title} ",
                    "--border-label-pos=3",
                    "--header", prompt,
                    "--header-first",
                    "--pointer=▶",
                ],
                input="No\nYes",
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                return False
            return result.stdout.strip() == "Yes"
        except OSError:
            pass

    if shutil.which("whiptail") and has_tty():
        try:
            code = subprocess.call(
                ["whiptail", "--title", title, "--yesno", prompt, "14", "74", "--defaultno"],
                stderr=subprocess.DEVNULL,
            )
            return code == 0
        except OSError:
            pass
    try:
        with open("/dev/tty", "w") as out, open("/dev/tty", "r") as inp:
            out.write(f"{prompt}\n[y/N] ")
            out.flush()
            return inp.readline().strip().lower() in ("y", "yes")
    except OSError:
        return False


def message(text: str, title: str = "vibe-sessions") -> None:
    """Show a notice, in a box when we can."""
    if shutil.which("whiptail"):
        try:
            if subprocess.call(
                ["whiptail", "--title", title, "--msgbox", text, "12", "74"],
                stderr=subprocess.DEVNULL,
            ) == 0:
                return
        except OSError:
            pass
    print(text, file=sys.stderr)


def delete_session(session: dict) -> None:
    """Remove a session directory and the bookkeeping that points at it."""
    path = Path(session["path"]).resolve()
    root = session_root().resolve()
    if root not in path.parents:
        raise ValueError(f"refusing to delete {path}: outside {root}")

    shutil.rmtree(path)

    active = session_root() / "active"
    for suffix in (".lock", ".lock.json"):
        try:
            (active / f"{session['id']}{suffix}").unlink()
        except OSError:
            pass

    pointers = session_root() / "continue-pointers"
    if pointers.is_dir():
        for pointer in pointers.iterdir():
            try:
                if pointer.read_text().strip() == session["id"]:
                    pointer.unlink()
            except OSError:
                continue

    # Per-session plugin state, keyed by session id.
    plugin_data = session_root() / "plugins" / "data" / session["id"]
    if plugin_data.is_dir():
        shutil.rmtree(plugin_data, ignore_errors=True)


ALLOWLIST_ENTRY = re.compile(
    r'^\s*"vibe-path:exact:(?P<path>[^"]*/unified/(?P<sid>[0-9a-f-]{36})[^"]*)"\s*,?\s*$'
)


def cmd_prune_config(dry_run: bool) -> int:
    """Drop allowlist entries that point at sessions which no longer exist.

    Deleting a session leaves its auto-approved paths behind in config.toml.
    They grant nothing once the directory is gone, but they accumulate. This
    only ever removes lines that name a session directory that is missing.
    """
    config = vibe_home() / "config.toml"
    if not config.is_file():
        print("no config.toml to prune", file=sys.stderr)
        return 0

    lines = config.read_text().splitlines(keepends=True)
    stale: list[tuple[int, str]] = []
    for index, line in enumerate(lines):
        match = ALLOWLIST_ENTRY.match(line)
        if not match:
            continue
        if not (session_root() / "unified" / match.group("sid")).is_dir():
            stale.append((index, line.strip()))

    if not stale:
        print("no stale allowlist entries")
        return 0

    for _, entry in stale:
        print(("would remove: " if dry_run else "removed: ") + entry)
    if dry_run:
        print(f"\n{len(stale)} stale entr{'y' if len(stale) == 1 else 'ies'} (dry run)")
        return 0

    backup = config.with_suffix(".toml.bak.vibe-sessions")
    shutil.copy2(config, backup)
    drop = {index for index, _ in stale}
    config.write_text("".join(line for i, line in enumerate(lines) if i not in drop))
    print(f"\n{len(stale)} removed; backup at {backup}")
    return 0


def cmd_delete(session: dict, force: bool) -> int:
    title = session["title"] or "(untitled)"
    if session["pid"]:
        message(
            f"'{title}' is open in a running Vibe process (pid {session['pid']}).\n\n"
            "Close that session before deleting it.",
            "Cannot delete",
        )
        return 1

    if not force:
        prompt = (
            f"Delete this session?\n\n"
            f"{title}\n"
            f"{session['directory'] or '?'}\n\n"
            f"The session directory is removed permanently."
        )
        if not confirm(prompt, "Delete session"):
            return 130

    try:
        delete_session(session)
    except (OSError, ValueError) as error:
        message(f"Could not delete the session:\n\n{error}", "Delete failed")
        return 1

    print(f"deleted {session['short']}  {title}")
    return 0


def whiptail(args: list[str]) -> tuple[int, str]:
    """Run whiptail with its UI on the terminal and its answer on a pipe.

    whiptail draws on stdout, so capturing stdout would swallow the box. It
    writes the answer to --output-fd instead, which leaves stdout alone.
    """
    read_fd, write_fd = os.pipe()
    try:
        code = subprocess.call(
            args + ["--output-fd", str(write_fd)],
            pass_fds=(write_fd,),
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        os.close(read_fd)
        os.close(write_fd)
        return 255, ""
    finally:
        try:
            os.close(write_fd)
        except OSError:
            pass
    chunks = []
    while True:
        try:
            chunk = os.read(read_fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        chunks.append(chunk)
    os.close(read_fd)
    return code, b"".join(chunks).decode("utf-8", "replace").strip()


def ask(prompt: str, title: str, default: str = "") -> str | None:
    """Single-line input box. Returns None when cancelled.

    fzf's --print-query gives a text field that understands every key encoding,
    which whiptail nested inside fzf does not (see confirm()).
    """
    if shutil.which("fzf"):
        try:
            clear_screen()
            result = subprocess.run(
                [
                    "fzf",
                    "--print-query",
                    "--height=~20%",
                    "--layout=reverse",
                    "--no-info",
                    "--border=rounded",
                    f"--border-label= {title} ",
                    "--border-label-pos=3",
                    "--header", prompt,
                    "--header-first",
                    f"--query={default}",
                ],
                input="",
                capture_output=True,
                text=True,
            )
            # With --print-query and no items, Enter exits 1 ("no match") while
            # still printing the query, so the exit code cannot mean "cancel".
            # Esc exits 130 and prints nothing.
            if result.returncode == 130:
                return None
            lines = result.stdout.splitlines()
            return lines[0] if lines else None
        except OSError:
            pass

    if shutil.which("whiptail") and has_tty():
        code, answer = whiptail(
            ["whiptail", "--title", title, "--inputbox", prompt, "12", "74", default]
        )
        return answer if code == 0 else None
    try:
        with open("/dev/tty", "w") as out, open("/dev/tty", "r") as inp:
            out.write(f"{prompt}\n[{default}] ")
            out.flush()
            answer = inp.readline().strip()
            return answer or default
    except OSError:
        return None


def menu(text: str, title: str, items: list[tuple[str, str]]) -> str | None:
    """A tmux display-menu style list of actions. Returns the chosen tag.

    fzf is preferred over whiptail here: this runs inside fzf's own `execute`,
    and a nested fzf restores the terminal correctly, whereas whiptail draws
    but never receives the keystrokes.
    """
    if shutil.which("fzf"):
        lines = [f"{tag}\t{label}" for tag, label in items]
        try:
            clear_screen()
            result = subprocess.run(
                [
                    "fzf",
                    "--delimiter=\t",
                    "--with-nth=2",
                    "--height=12",
                    "--layout=reverse",
                    "--border=rounded",
                    f"--border-label= {title} ",
                    "--border-label-pos=3",
                    "--header", text,
                    "--header-first",
                    "--no-info",
                    "--pointer=▶",
                ],
                input="\n".join(lines),
                capture_output=True,
                text=True,
            )
            if result.returncode != 0:
                return None
            return result.stdout.rstrip("\n").split("\t")[0]
        except OSError:
            pass

    if shutil.which("whiptail") and has_tty():
        args = ["whiptail", "--title", title, "--menu", text, "18", "78", str(len(items))]
        for tag, label in items:
            args += [tag, label]
        code, answer = whiptail(args)
        return answer if code == 0 else None
    try:
        with open("/dev/tty", "w") as out, open("/dev/tty", "r") as inp:
            out.write(f"{text}\n\n")
            for index, (_, label) in enumerate(items, 1):
                out.write(f"  {index}) {label}\n")
            out.write("choose: ")
            out.flush()
            raw = inp.readline().strip()
            if not raw:
                return None
            return items[int(raw) - 1][0]
    except (OSError, ValueError, IndexError):
        return None


def rename_session(session: dict, title: str) -> None:
    """Set a manual title in meta.json, the same field Vibe's /rename writes."""
    if session["pid"]:
        raise ValueError("the session is open in a running Vibe process")
    meta_path = Path(session["path"]) / "meta.json"
    meta = json.loads(meta_path.read_text())
    meta["title"] = title
    meta["title_source"] = "manual"
    meta_path.write_text(json.dumps(meta, indent=2) + "\n")


def cmd_rename(session: dict, title: str | None) -> int:
    if title is None:
        title = ask("New title:", "Rename session", session["title"] or "")
        if title is None:
            return 130
    title = title.strip()
    if not title:
        message("A session needs a title.", "Rename failed")
        return 1
    try:
        rename_session(session, title)
    except (OSError, ValueError) as error:
        message(f"Could not rename the session:\n\n{error}", "Rename failed")
        return 1
    print(f"renamed {session['short']}  {title}")
    return 0


def cmd_tag(session: dict, tags: str | None) -> int:
    if tags is None:
        tags = ask(
            "Tags, comma separated (empty clears):",
            "Tag session",
            ", ".join(session.get("tags") or []),
        )
        if tags is None:
            return 130
    parsed = [tag.strip().lstrip("#") for tag in tags.split(",")]
    parsed = [tag for tag in parsed if tag]
    set_session_tags(session["id"], parsed)
    print(f"tagged {session['short']}  {' '.join('#' + t for t in parsed) or '(no tags)'}")
    return 0


def cmd_menu(session: dict) -> int:
    """Right-click menu: the management actions for one session."""
    title = session["title"] or "(untitled)"
    tags = " ".join(f"#{tag}" for tag in session.get("tags") or []) or "(none)"
    text = f"{title}\n{session['directory'] or '?'}\nTags: {tags}"

    choice = menu(
        text,
        "Session",
        [
            ("rename", "Rename this session"),
            ("tag", "Tag this session"),
            ("delete", "Delete this session"),
            ("cancel", "Cancel"),
        ],
    )
    if choice is None or choice == "cancel":
        return 130
    if choice == "rename":
        return cmd_rename(session, None)
    if choice == "tag":
        return cmd_tag(session, None)
    if choice == "delete":
        return cmd_delete(session, force=False)
    return 130


def pick(sessions: list[dict], args) -> int:
    if not sessions:
        print("No sessions found.", file=sys.stderr)
        return 1

    if not shutil.which("fzf"):
        return pick_fallback(sessions, args)

    script = str(Path(sys.argv[0]).resolve())
    lines = []
    for session in sessions:
        row = table_row(session, color=True)
        lines.append(f"{row}\t{session['id']}")

    header = (
        "enter resume  ·  ctrl-y copy id  ·  ctrl-x delete  ·  "
        "→ / right-click menu  ·  ctrl-s sort  ·  esc cancel"
    )
    if args.only_folder:
        header += "   (this folder only)"

    # `reload` must rebuild the list with the same filters the picker started with.
    reload_cmd = f"{sys.executable} {script} --raw"
    if args.all:
        reload_cmd += " --all"
    if args.only_folder:
        reload_cmd += " --folder"
    delete_cmd = f"{sys.executable} {script} --delete {{2}}"
    menu_cmd = f"{sys.executable} {script} --menu {{2}}"
    cycle_cmd = f"{sys.executable} {script} --cycle-sort"

    # Right arrow opens the menu for keyboard-only use, but only when the query
    # is empty: while typing, it must stay forward-char or the cursor breaks.
    menu_action = f"execute({menu_cmd})+reload({reload_cmd})"
    right_bind = (
        "right:transform:"
        'if [ -n "$FZF_QUERY" ]; then echo forward-char; '
        'else echo "' + menu_action + '"; fi'
    )

    fzf = [
        "fzf",
        "--ansi",
        "--delimiter=\t",
        "--with-nth=1",
        "--height=100%",
        "--layout=reverse",
        # Keep the cursor on the same session across the reload that follows a
        # delete attempt; without this it jumps to row 1 and the next delete
        # would hit the wrong session.
        "--track",
        "--border=rounded",
        "--border-label= vibe sessions ",
        "--border-label-pos=3",
        "--info=inline-right",
        f"--header={header}",
        "--header-first",
        "--pointer=▶",
        "--marker= ",
        "--preview", f"{sys.executable} {script} --preview {{2}}",
        "--preview-window=right,60%,wrap,border-left",
        "--bind=ctrl-y:execute-silent(printf %s {2} | (wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b 2>/dev/null || true))+change-header(id copied)",
        f"--bind=ctrl-x:execute({delete_cmd})+reload({reload_cmd})",
        f"--bind=right-click:execute({menu_cmd})+reload({reload_cmd})",
        f"--bind={right_bind}",
        f"--bind=ctrl-s:execute({cycle_cmd})+reload({reload_cmd})",
    ]
    if args.filter:
        fzf += ["--filter", args.filter]

    try:
        result = subprocess.run(
            fzf,
            input="\n".join(lines),
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        return pick_fallback(sessions, args)

    if result.returncode != 0 or not result.stdout.strip():
        return 130

    if args.filter:
        # Non-interactive: fzf printed every match, not a single selection.
        matches = [line for line in result.stdout.splitlines() if line.strip()]
        if args.print:
            chosen_id = matches[0].split("\t")[-1]
            session = next((s for s in sessions if s["id"] == chosen_id), None)
            if session is None:
                return 1
            return resume(session, change_dir=not args.no_cd, print_only=True, exec_shell=False)
        for line in matches:
            print(line.split("\t")[0])
        return 0

    chosen_id = result.stdout.rstrip("\n").split("\t")[-1]
    session = next((s for s in sessions if s["id"] == chosen_id), None)
    if session is None:
        print(f"vibe-sessions: unknown session {chosen_id}", file=sys.stderr)
        return 1
    return resume(session, change_dir=not args.no_cd, print_only=args.print, exec_shell=args.exec)


def pick_fallback(sessions: list[dict], args) -> int:
    """Numbered menu for machines without fzf."""
    print_table(sessions, color=sys.stdout.isatty())
    print()
    try:
        choice = input(
            "resume which session? [1-%d, d<N> to delete, empty to cancel] " % len(sessions)
        ).strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return 130
    if not choice:
        return 130

    deleting = choice[:1] in ("d", "D")
    if deleting:
        choice = choice[1:].strip()
    try:
        session = sessions[int(choice) - 1]
    except (ValueError, IndexError):
        print("vibe-sessions: not a valid choice", file=sys.stderr)
        return 1
    if deleting:
        return cmd_delete(session, force=False)
    return resume(session, change_dir=not args.no_cd, print_only=args.print, exec_shell=args.exec)


